Package: toxval
Title: Functions for Extracting NSEC and ECx Values from fitted
    Frequentist and Bayesian Model Objects
Version: 1.0.0.9000
Authors@R: c(
    person("Rebecca", "Fisher", , "r.fisher@aims.gov.au", role = c("aut", "cre")),
    person("Diego", "Barneche", role = "aut"),
    person("Darren", "Koppel", role = "aut"),
